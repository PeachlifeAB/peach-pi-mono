{
	"name": "pi-peachlife-mono",
	"private": true,
	"type": "module",
	"version": "0.0.1",
	"packageManager": "pnpm@12.15.0",
	"scripts": {
		"preinstall": "node scripts/check-package-manager.mjs",
		"check": "pnpm run check:fast && pnpm run lint:dead-code",
		"check:fast": "pnpm run check:globs && pnpm run check:deps && pnpm run lint && pnpm run typecheck && pnpm run lint:circular && pnpm run lint:arch && pnpm run lint:decision-codes && pnpm run check:schemas && pnpm run test:hooks",
		"check:deps": "syncpack lint --dependency-types prod,dev,peer",
		"check:deps:fix": "syncpack fix --dependency-types prod,dev,peer",
		"check:fix": "biome check --write --error-on-warnings .",
		"check:globs": "node scripts/check-globs.mjs",
		"check:schemas": "pnpm -r --if-present run schema:check",
		"format": "biome format --write .",
		"fmt": "biome check --error-on-warnings .",
		"lint": "biome check --error-on-warnings .",
		"lint:arch": "depcruise packages/*/index.ts packages/*/src --config .dependency-cruiser.cjs",
		"lint:circular": "node scripts/check-circular.mjs packages/*/src",
		"lint:dead-code": "knip",
		"lint:decision-codes": "node scripts/check-no-decision-codes.mjs packages/*/src packages/*/test scripts",
		"typecheck": "tsc --noEmit -p tsconfig.base.json",
		"test": "pnpm -r run test",
		"test:hooks": "node --test tests/pre-commit-partial-staging.test.mjs",
		"coverage": "pnpm -r --if-present run test:coverage",
		"crap": "gdog gate crap",
		"mutation:dry": "stryker run --dryRunOnly",
		"mutation": "stryker run",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@stryker-mutator/core": "10.1.1",
		"@stryker-mutator/vitest-runner": "10.1.1",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"c8": "catalog:",
		"dependency-cruiser": "catalog:",
		"husky": "catalog:",
		"knip": "catalog:",
		"lint-staged": "17.6.0",
		"syncpack": "15.3.3",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">=22.22.1"
	}
}
