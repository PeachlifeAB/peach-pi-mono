{
	"name": "@peachlife/ppie-trail",
	"version": "0.1.0",
	"description": "pi extension exposing the trail codebase graph as a tool, with per-session orientation and token-savings tracking",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PeachlifeAB/peach-pi-mono.git",
		"directory": "packages/ppie-trail"
	},
	"homepage": "https://github.com/PeachlifeAB/peach-pi-mono/tree/main/packages/ppie-trail#readme",
	"bugs": {
		"url": "https://github.com/PeachlifeAB/peach-pi-mono/issues"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"trail"
	],
	"type": "module",
	"files": [
		"src",
		"skills",
		"README.md",
		"LICENSE",
		"!**/*.test.ts"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		],
		"skills": [
			"./skills/trail/SKILL.md"
		]
	},
	"scripts": {
		"test": "vitest run -c vitest.config.ts",
		"test:coverage": "vitest run -c vitest.config.ts --coverage",
		"release": "npm publish --access public",
		"prepublishOnly": "pnpm test"
	},
	"dependencies": {
		"ajv": "^8.20.0"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^1.4.0"
	}
}
