{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"decision": {
			"type": "string"
		},
		"reason": {
			"type": "string"
		},
		"systemMessage": {
			"type": "string"
		},
		"hookSpecificOutput": {
			"type": "object",
			"properties": {
				"hookEventName": {
					"type": "string"
				},
				"additionalContext": {
					"type": "string"
				},
				"permissionDecision": {
					"enum": [
						"allow",
						"ask",
						"deny"
					]
				},
				"permissionDecisionReason": {
					"type": "string"
				}
			}
		}
	},
	"$defs": {
		"input": {
			"type": "object",
			"required": [
				"cwd",
				"session_id"
			],
			"additionalProperties": false,
			"properties": {
				"cwd": {
					"type": "string"
				},
				"session_id": {
					"type": "string"
				},
				"prompt": {
					"type": "string"
				},
				"tool_name": {
					"type": "string"
				},
				"tool_use_id": {
					"type": "string"
				},
				"tool_input": {
					"type": "object"
				},
				"tool_response": {
					"type": "object"
				},
				"last_assistant_message": {
					"type": "string"
				},
				"stop_hook_active": {
					"type": "boolean"
				},
				"context_window": {
					"type": "object",
					"required": [
						"used_percentage"
					],
					"properties": {
						"used_percentage": {
							"type": "number"
						}
					}
				}
			}
		}
	}
}
